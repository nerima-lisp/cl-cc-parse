(progn
  (require :asdf)
  (let* ((root (truename (uiop:ensure-directory-pathname (first (uiop:command-line-arguments)))))
         (test-root (merge-pathnames #p"t/" root)))
    (asdf:initialize-source-registry
     (list :source-registry (list :tree root) :ignore-inherited-configuration))
    (labels ((component-files (component)
               (if (typep component 'asdf:module)
                   (mapcan #'component-files (asdf:component-children component))
                   (let ((pathname (asdf:component-pathname component)))
                     (if (and (pathname-type pathname)
                              (string-equal (pathname-type pathname) "lisp"))
                         (list (namestring pathname))
                         nil))))
             (directory-lisp-files (directory)
               (append
                (mapcan (lambda (pathname)
                          (if (and (pathname-type pathname)
                                   (string-equal (pathname-type pathname) "lisp"))
                              (list (namestring pathname))
                              nil))
                        (uiop:directory-files directory))
                (mapcan #'directory-lisp-files (uiop:subdirectories directory)))))
      (let* ((system (asdf:find-system "cl-cc-parse/test"))
             (declared (sort (remove-duplicates (component-files system) :test #'equal) #'string<))
             (discovered (sort (directory-lisp-files test-root) #'string<))
             (orphans (set-difference discovered declared :test #'equal))
             (missing (set-difference declared discovered :test #'equal)))
        (unless declared
          (error "No Lisp components found in cl-cc-parse/test"))
        (unless discovered
          (error "No Lisp source files found under t/"))
        (when (or orphans missing)
          (dolist (pathname orphans)
            (format *error-output* "Unregistered Lisp source under t/: ~a~%" pathname))
          (dolist (pathname missing)
            (format *error-output* "No matching t/ file for ASDF component: ~a~%" pathname))
          (error "ASDF test file inventory differs from t/ Lisp sources"))
        (format t "Matched ~d ASDF test components to ~d Lisp files under t/~%"
                (length declared)
                (length discovered))))))
